generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // ou "postgress"
  url      = env("DATABASE_URL")
}
model User {
  id          String       @id @default(uuid())
  full_name   String
  email       String       @unique
  pswd        String      
  phone       String?
  gender      String? 
  status      Boolean      @default(true)
  deleted     Boolean      @default(false)
  profil      String? 
  dateBorn    DateTime?
  provider    String?
  fingerprint String? 
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Section {
  id         String      @id @default(uuid())
  name       String
  promotions Promotion[]
}

model Promotion {
  id         String     @id @default(uuid())
  name       String
  sectionId  String
  section    Section    @relation(fields: [sectionId], references: [id])
  students   Student[]
}

model Student {
  id           String     @id @default(uuid())
  matricule    String     @unique
  fullName     String
  fingerprint  String     // Empreinte encodée (base64 ou hash)
  promotionId  String
  promotion    Promotion  @relation(fields: [promotionId], references: [id])
  presences    Presence[]
}

model Exam {
  id        String     @id @default(uuid())
  name      String
  date      DateTime
  presences Presence[]
}

model Presence {
  id         String    @id @default(uuid())
  studentId  String
  examId     String
  timestamp  DateTime  @default(now())

  student    Student   @relation(fields: [studentId], references: [id])
  exam       Exam      @relation(fields: [examId], references: [id])
  
  @@unique([studentId, examId]) // Un étudiant ne peut être enregistré qu'une fois par examen
}
